{
  // 일기장 — Cloudflare Worker (화면 파일 + 일기 저장)
  "name": "diary",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    // database_id = `npx wrangler d1 create diary` 로 만든 저장소 번호. preview_database_id = npm run dev 로 실행할 때 쓰는 저장소
    {
      "binding": "DB",
      "database_name": "diary",
      "database_id": "YOUR_DATABASE_ID",
      "preview_database_id": "00000000-0000-0000-0000-000000000000"
    }
  ]
}
