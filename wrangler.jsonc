{
  // 일기장 — Cloudflare Worker (화면 파일 + 일기 저장)
  "name": "diary",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    // database_id = Cloudflare 에 만든 일기 저장소. preview_database_id = 내 컴퓨터 서버(서버켜기.bat)가 쓰는 저장소(예전 값 그대로 둬야 내 컴퓨터 일기가 보인다)
    {
      "binding": "DB",
      "database_name": "diary",
      "database_id": "YOUR_DATABASE_ID",
      "preview_database_id": "00000000-0000-0000-0000-000000000000"
    }
  ]
}
